{
  "about": "Meera's rig values (v2). Units are drawing px and degrees. The artboard is the 328 x 430 call tile; the whole drawing sits in group 'meera', offset by (-36, -30), and every pivot below is in the drawing's own coordinates inside that group. Values are offsets from the neutral pose in meera-parts.svg.",
  "artboard": {
    "width": 328,
    "height": 430,
    "drawingOffset": [
      -36,
      -30
    ]
  },
  "controls": {
    "head": {
      "rot": "degrees around pivot 200 300, positive is clockwise"
    },
    "turn": "head turn, -1 to 1 (about ±4°). Drives the parallax values below; keep them in step",
    "parallax": {
      "features": "tx",
      "nose": "tx",
      "face": "tx",
      "hair_front": "tx",
      "hair_back": "tx",
      "ear_L": "tx, sx (narrows when it is the far ear)",
      "ear_R": "tx, sx",
      "rates": {
        "features": 5,
        "nose": 6.5,
        "face": 1,
        "hair_front": 2,
        "hair_back": -1.5,
        "ears": -1.2,
        "farEar": 0.24
      }
    },
    "lock_L": {
      "rot": "degrees around 128 236: hair follow-through"
    },
    "lock_R": {
      "rot": "degrees around 272 236"
    },
    "blush": {
      "opacity": "0 to 1, applies to blush_L and blush_R"
    },
    "brow_L": {
      "ty": "px, negative is up",
      "rot": "degrees around the brow pivot, world space",
      "arch": "0 to 1 blend between brow shapes arch_min and arch_max"
    },
    "lid_upper_L": {
      "ty": "px from neutral, positive is down. 42.32 is fully closed",
      "rot": "degrees around the lid pivot"
    },
    "lid_lower_L": {
      "ty": "px, negative is up (cheek push)",
      "line": "opacity of lid_lower_line"
    },
    "lash_flick_L": {
      "ty": "px"
    },
    "pupil_L": {
      "tx": "px",
      "ty": "px",
      "scale": "around the pupil pivot"
    },
    "eye_L": "open | happy | closed: which of eye_open_L, eye_happy_L, eye_closed_L is visible",
    "mouth": "the one mouth layer that is visible",
    "arm": "pose: rest | writing | hold | watch. rest and writing move arm_R (tx, ty); hold and watch swap to arm_hold or arm_watch and hide arm_R"
  },
  "browShapes": {
    "arch_min": "M-23 3 Q-6 -6 23 -1 Q25 4 21 6 Q-4 2 -21 8 Q-26 7 -23 3 Z",
    "neutral": "M-23 3 Q-6 -9 23 -1 Q25 4 21 6 Q-4 -1 -21 8 Q-26 7 -23 3 Z",
    "arch_max": "M-23 3 Q-6 -15 23 -1 Q25 4 21 6 Q-4 -7 -21 8 Q-26 7 -23 3 Z",
    "neutralArch": 0.33,
    "note": "Path is in brow-local space. brow_shape_R is the same path mirrored with scale(-1 1)."
  },
  "blink": {
    "lid_upper_ty": 42.32,
    "closeMs": 70,
    "holdMs": 30,
    "openMs": 110
  },
